# Copy this file to .env in THIS folder (spidersense/.env, git-ignored). Never commit real keys.
OPENROUTER_JEV_KEY=            # OpenRouter key used for Jev (POST /api/alpha/decisions, model typesafe/jev-1.13)
FREELLM_GATEWAY_KEY=           # hosted FreeLLMAPI gateway key (flg_...)
FREELLM_BASE_URL=https://free-llmapi-six.vercel.app/api/v1
FREELLM_ENV_PATH=C:/Shashank/VeriDuce/VeriDuce/free_llm-check/.env   # direct free-tier provider keys, read by reference
# Optional switches
# LLM_GATEWAY=first|last|off     (default last: direct providers are faster; the gateway is a fallback)
# LLM_CACHE=readwrite|readonly|off   JEV_CACHE=readwrite|readonly|off   (readonly = exact replay)
# JEV_MODE=live|stub             (stub = offline heuristics, NOT Jev)

# 5 general-purpose providers (src/llm/client.ts GENERAL_PROVIDERS): set ONE of these and every chat() call
# uses it instead of the default FreeLLMAPI path above, no other config needed. Checked in this order; leave
# ALL of them unset to keep using FreeLLMAPI Vercel (the default). Optional "${ID}_MODEL" override per row.
# OPENAI_API_KEY=                 # OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=              # ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENROUTER_API_KEY=             # OPENROUTER_GENERAL_MODEL=openai/gpt-4o-mini (separate from OPENROUTER_JEV_KEY above)
# TOGETHER_API_KEY=               # TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# FIREWORKS_API_KEY=              # FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
